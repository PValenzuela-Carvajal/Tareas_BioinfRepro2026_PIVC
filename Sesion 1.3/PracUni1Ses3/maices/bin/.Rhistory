ggplot(centroides, aes(x = PC1, y = PC2, color = ambiente)) +
geom_point(size = 4) +
scale_color_gradient2(
low = "blue",
mid = "white",
high = "red",
midpoint = 0,
name = "Variable\nambiental"
) +
labs(
x = "PC1",
y = "PC2",
title = "PCA de las poblaciones",
subtitle = "Centroides poblacionales (100 individuos por población)"
) +
theme_classic() +
theme(
plot.title = element_text(hjust = 0.5),
plot.subtitle = element_text(hjust = 0.5),
legend.position = "right"
)
