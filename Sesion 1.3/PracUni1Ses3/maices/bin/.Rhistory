tabla_maices<- read.delim(file="../meta/maizteocintle_SNP50k_meta_extended.txt",
header=TRUE, sep = "\t", fileEncoding = "latin1")
print(class(tabla_maices))
# How do the first 6 lines of the file look?
print(head(tabla_maices))
# How many samples are there?
print(nrow(tabla_maices))
# From how many states are there samples?
print(unique(tabla_maices$Estado))
print(length(unique(tabla_maices$Estado)))
# How many samples were collected before 1980?
print(sum(tabla_maices$AÌ.o._de_colecta[!is.na(tabla_maices$AÌ.o._de_colecta)] < 1980))
# How many samples are there of each race?
print(table(tabla_maices$Raza))
# On average, at what altitude were the samples collected?
print(mean(tabla_maices$Altitud))
# And at what maximum and minimum altitude were they collected?
print(c(min = min(tabla_maices$Altitud),
max = max(tabla_maices$Altitud)))
